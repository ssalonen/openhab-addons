	<channel-type id="readIntoHexString">
		<item-type>String</item-type>
		<label>Interpret read data as hexadecimal string</label>
		<description><![CDATA[Raw read data is presented in hexadecimal string format. For example e.g. 03FAFFFF can represent two 16bit words, 0x03FA and 0xFFFF.
        This allows you get coherent access to raw data received from Modbus.]]></description>
		<config-description-ref uri="thing-type:modbus:read_into_hexstring_channel"></config-description-ref>
	</channel-type>
