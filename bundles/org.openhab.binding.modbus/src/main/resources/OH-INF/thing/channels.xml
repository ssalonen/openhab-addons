<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="modbus"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<channel-type id="readIntoHexString">
		<item-type>String</item-type>
		<label>Interpret read data as hexadecimal string</label>
		<description><![CDATA[Raw read data is presented in hexadecimal string format. For example e.g. 03FAFFFF can represent two 16bit words, 0x03FA and 0xFFFF.
        This allows you get coherent access to raw data received from Modbus.]]></description>
		<config-description-ref uri="thing-type:modbus:read_into_hexstring_channel"></config-description-ref>
	</channel-type>
	<channel-type id="readIntoNumber">
		<item-type>Number</item-type>
		<label>Interpret read data as number</label>
		<config-description-ref uri="thing-type:modbus:read_into_number_channel"></config-description-ref>
	</channel-type>
	<channel-type id="readIntoOnOff">
		<item-type>Switch</item-type>
		<label>Interpret read data as ON/OFF</label>
		<config-description-ref uri="thing-type:modbus:read_into_on_off_channel"></config-description-ref>
	</channel-type>
	<channel-type id="readIntoOpenClosed">
		<item-type>Contact</item-type>
		<label>Interpret read data as OPEN/CLOSED</label>
		<config-description-ref uri="thing-type:modbus:read_into_open_closed_channel"></config-description-ref>
	</channel-type>
	<channel-type id="readIntoPercent">
		<item-type>Dimmer</item-type>
		<label>Interpret read data as percent (0-100%)</label>
		<config-description-ref uri="thing-type:modbus:read_into_number_channel"></config-description-ref>
	</channel-type>
	
    <channel-type id="writeRegisterFromNumber">
        <item-type>Number</item-type>
        <label>Write register from DecimalType number commands</label>
        <config-description-ref uri="thing-type:modbus:write_register_from_number_channel"></config-description-ref>
    </channel-type>
    <channel-type id="writeRegisterFromOnOff">
        <item-type>Switch</item-type>
        <label>Write register from ON/OFF commands</label>
        <config-description-ref uri="thing-type:modbus:write_register_from_on_off_channel"></config-description-ref>
    </channel-type>
    <channel-type id="writeRegisterFromOpenClosed">
        <item-type>Contact</item-type>
        <label>Write register from OPEN/CLOSED commands</label>
        <config-description-ref uri="thing-type:modbus:write_register_from_open_closed_channel"></config-description-ref>
    </channel-type>
    <channel-type id="writeRegisterFromPercent">
        <item-type>Dimmer</item-type>
        <label>Write register from percent (0-100%) commands</label>
        <config-description-ref uri="thing-type:modbus:write_register_from_percent_channel"></config-description-ref>
    </channel-type>
    
    <channel-type id="writeCoilFromNumber">
        <item-type>Number</item-type>
        <label>Write coil from number commands</label>
        <config-description-ref uri="thing-type:modbus:write_coil_from_number_channel"></config-description-ref>
    </channel-type>
    <channel-type id="writeCoilFromOnOff">
        <item-type>Switch</item-type>
        <label>Write coil from ON/OFF commands</label>
        <config-description-ref uri="thing-type:modbus:write_coil_from_on_off_channel"></config-description-ref>
    </channel-type>
    <channel-type id="writeCoilFromOpenClosed">
        <item-type>Contact</item-type>
        <label>Write coil from OPEN/CLOSED commands</label>
        <config-description-ref uri="thing-type:modbus:write_coil_from_open_closed_channel"></config-description-ref>
    </channel-type>    
    
</thing:thing-descriptions>